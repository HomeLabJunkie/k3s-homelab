# jeffriffle.com: the private HomeLabJunkie/jeffriffle.com repo builds the site onto its
# `deploy` branch. git-sync keeps a checkout of that branch current (checking every 60s)
# and nginx serves it. Edits made at /admin go live without a rollout.
# deploy.sh creates the jeffriffle-git Secret (read-only deploy key) from WEBSITE_DEPLOY_KEY_B64.
# The nginx config and GitHub host keys (ConfigMap jeffriffle) are in website-nginx.yaml,
# outside templates/ so envsubst leaves nginx's variables alone.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: jeffriffle
  namespace: website
spec:
  replicas: 2
  selector:
    matchLabels:
      app: jeffriffle
  template:
    metadata:
      labels:
        app: jeffriffle
    spec:
      securityContext:
        # git-sync runs as 65533; the group lets it read the deploy key
        fsGroup: 65533
        seccompProfile:
          type: RuntimeDefault
      initContainers:
      # First checkout, so nginx never starts with an empty directory
      - name: git-sync-init
        image: registry.k8s.io/git-sync/git-sync:v4.7.1
        args:
        - --repo=git@github.com:HomeLabJunkie/jeffriffle.com.git
        - --ref=deploy
        - --depth=1
        - --root=/git
        - --link=current
        - --ssh-key-file=/etc/git-secret/ssh
        - --ssh-known-hosts-file=/etc/git-known-hosts/known_hosts
        - --one-time
        volumeMounts: &gitsync-mounts
        - name: git
          mountPath: /git
        - name: git-secret
          mountPath: /etc/git-secret
          readOnly: true
        - name: config
          mountPath: /etc/git-known-hosts
          readOnly: true
        # git-sync's HOME; it writes a gitconfig there
        - name: git-sync-tmp
          mountPath: /tmp
        securityContext: &restricted
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop: [ALL]
        resources: &gitsync-resources
          requests:
            cpu: 10m
            memory: 32Mi
          limits:
            memory: 128Mi
      # Native sidecar: keeps /git/current in step with the deploy branch
      - name: git-sync
        image: registry.k8s.io/git-sync/git-sync:v4.7.1
        restartPolicy: Always
        args:
        - --repo=git@github.com:HomeLabJunkie/jeffriffle.com.git
        - --ref=deploy
        - --depth=1
        - --root=/git
        - --link=current
        - --ssh-key-file=/etc/git-secret/ssh
        - --ssh-known-hosts-file=/etc/git-known-hosts/known_hosts
        - --period=60s
        volumeMounts: *gitsync-mounts
        securityContext: *restricted
        resources: *gitsync-resources
      containers:
      - name: nginx
        image: nginxinc/nginx-unprivileged:1.30-alpine
        ports:
        - containerPort: 8080
          name: http
        volumeMounts:
        - name: git
          mountPath: /git
          readOnly: true
        - name: config
          mountPath: /etc/nginx/conf.d/default.conf
          subPath: default.conf
          readOnly: true
        - name: nginx-tmp
          mountPath: /tmp
        readinessProbe:
          httpGet:
            path: /healthz
            port: http
          periodSeconds: 10
        livenessProbe:
          httpGet:
            path: /healthz
            port: http
          periodSeconds: 30
        securityContext: *restricted
        resources:
          requests:
            cpu: 10m
            memory: 16Mi
          limits:
            memory: 64Mi
      volumes:
      - name: git
        emptyDir: {}
      - name: nginx-tmp
        emptyDir: {}
      - name: git-sync-tmp
        emptyDir: {}
      - name: git-secret
        secret:
          secretName: jeffriffle-git
          defaultMode: 0400
      - name: config
        configMap:
          name: jeffriffle
---
apiVersion: v1
kind: Service
metadata:
  name: jeffriffle
  namespace: website
spec:
  selector:
    app: jeffriffle
  ports:
  - port: 80
    targetPort: http

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: website
  namespace: website
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
spec:
  ingressClassName: traefik
  rules:
  - host: ${BASE_DOMAIN}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: jeffriffle
            port:
              number: 80
  tls:
  - hosts:
    - ${BASE_DOMAIN}
    secretName: tls-website
---
# www.${BASE_DOMAIN} permanently redirects to the bare domain, keeping the path.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: redirect-www
  namespace: website
spec:
  redirectRegex:
    regex: ^https?://www\.(.+)
    replacement: https://${1}
    permanent: true
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: website-www
  namespace: website
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
    traefik.ingress.kubernetes.io/router.middlewares: website-redirect-www@kubernetescrd
spec:
  ingressClassName: traefik
  rules:
  - host: www.${BASE_DOMAIN}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: jeffriffle
            port:
              number: 80
  tls:
  - hosts:
    - www.${BASE_DOMAIN}
    secretName: tls-website
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: tls-website
  namespace: website
spec:
  secretName: tls-website
  dnsNames:
  - ${BASE_DOMAIN}
  - www.${BASE_DOMAIN}
  issuerRef:
    name: letsencrypt-prod
    kind: ClusterIssuer

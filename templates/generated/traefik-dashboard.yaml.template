# The admin-ui-auth middleware (Authelia login with 2FA) is defined in
# authelia.yaml.template. Until Authelia is deployed the dashboard route fails
# closed.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: traefik-dashboard
  namespace: traefik
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`traefik.${BASE_DOMAIN}`)
      kind: Rule
      middlewares:
        - name: admin-ui-auth
      services:
        - name: api@internal
          kind: TraefikService
  tls:
    secretName: tls-traefik-dashboard

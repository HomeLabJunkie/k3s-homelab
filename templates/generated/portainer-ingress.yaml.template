apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: tls-portainer-ingress
  namespace: portainer
spec:
  secretName: tls-portainer-ingress
  issuerRef:
    name: letsencrypt-prod
    kind: ClusterIssuer
    group: cert-manager.io
  dnsNames:
    - portainer.${BASE_DOMAIN}
---
# An IngressRoute, not an Ingress: Traefik loads IngressRoutes and Middlewares
# together, so the route never starts up before its middleware exists.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: portainer
  namespace: portainer
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`portainer.${BASE_DOMAIN}`)
      kind: Rule
      middlewares:
        # Portainer keeps its own login behind Authelia; see authelia.yaml.template.
        - name: admin-ui-auth
          namespace: traefik
      services:
        - name: portainer
          port: 9000
  tls:
    secretName: tls-portainer-ingress

apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: tls-longhorn-ingress
  namespace: longhorn-system
spec:
  secretName: tls-longhorn-ingress
  issuerRef:
    name: letsencrypt-prod
    kind: ClusterIssuer
    group: cert-manager.io
  dnsNames:
    - longhorn.${BASE_DOMAIN}
---
# An IngressRoute, not an Ingress: Traefik loads IngressRoutes and Middlewares
# together, so the route never starts up before its middleware exists.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: longhorn-frontend
  namespace: longhorn-system
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`longhorn.${BASE_DOMAIN}`)
      kind: Rule
      middlewares:
        # Longhorn has no login of its own; see authelia.yaml.template.
        - name: admin-ui-auth
          namespace: traefik
      services:
        - name: longhorn-frontend
          port: 80
  tls:
    secretName: tls-longhorn-ingress

apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: longhorn-ingress
  namespace: longhorn-system
  annotations:
    kubernetes.io/ingress.class: traefik-external
spec:
  entryPoints:
    - websecure
  routes:
    - kind: Rule
      match: Host(`longhorn.${BASE_DOMAIN}`)
      middlewares:
        - name: longhorn-default-headers
        - name: longhorn-basic-auth
      services:
        - name: longhorn-frontend
          port: 80
  tls:
    secretName: jeffriffle-com-tls

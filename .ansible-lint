---
profile: production
extra_vars:
  target: 192.0.2.10

exclude_paths:
  # default paths
  - .cache/
  - .github/
  - test/fixtures/formatting-before/
  - test/fixtures/formatting-prettier/

  # The "converge" and "reset" playbooks use import_playbook in
  # conjunction with the "env" lookup plugin, which lets the
  # syntax check of ansible-lint fail.
  - molecule/**/converge.yml
  - molecule/**/prepare.yml
  - molecule/**/reset.yml

  # The file was generated by galaxy ansible - don't mess with it.
  - galaxy.yml

  # Kubernetes manifests, Helm values, and tool configuration are YAML but
  # are not Ansible content.
  - .sops.yaml
  - apps/
  - manifests/
  - recovery/generated-*.yaml
  - collections/requirements.yml
  - alloy-values.yaml
  - cloudflared-config.yaml
  - cloudflared.yaml
  - clusterissuer-letsencrypt.yaml
  - loki-values.yaml
  - longhorn-ingress.yaml
  - longhorn-values.yaml
  - monitoring-dashboards-v3.yaml
  - monitoring-dashboards.yaml
  - monitoring-ingress.yaml
  - monitoring-loki-datasource.yaml
  - monitoring-longhorn-v2.yaml
  - monitoring-values.yaml
  - portainer-ingress.yaml
  - portainer-values.yaml
  - traefik-dashboard-cert.yaml
  - traefik-dashboard.yaml
  - traefik-values.yaml
  - trilium-cert.yaml
  - trilium-ingress.yaml
  - trilium-longhorn-v2.yaml
  - trilium-longhorn.yaml
  - vaultwarden-cert.yaml
  - vaultwarden-longhorn-v2.yaml
  - vaultwarden-longhorn.yaml
  - website.yaml

skip_list:
  - var-naming[no-role-prefix]

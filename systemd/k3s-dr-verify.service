[Unit]
OnFailure=k3s-dr-monitor.service
Description=Verify latest K3s disaster-recovery backup
After=network-online.target k3s-dr-backup.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=%h
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/bin
WorkingDirectory=%h/Work/k3s-homelab
ExecStart=%h/Work/k3s-homelab/backup/verify-backup.sh
TimeoutStartSec=20min

{
  "title": "Homelab - Security Scanning",
  "uid": "homelab-trivy",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "tags": [
    "homelab",
    "k3s",
    "security"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Critical vulnerabilities",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(max by (image_registry, image_repository, image_tag) (trivy_image_vulnerabilities{severity=\"Critical\"}))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Each image is counted once, however many workloads run it."
    },
    {
      "id": 2,
      "title": "High vulnerabilities",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(max by (image_registry, image_repository, image_tag) (trivy_image_vulnerabilities{severity=\"High\"}))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Each image is counted once, however many workloads run it."
    },
    {
      "id": 3,
      "title": "Images scanned",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(max by (image_registry, image_repository, image_tag) (trivy_image_vulnerabilities))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Exposed secrets in images",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(trivy_image_exposedsecrets) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Credentials found inside image layers. Anything above zero needs a look."
    },
    {
      "id": 5,
      "title": "Manifest audit: critical + high",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(trivy_resource_configaudits{severity=~\"Critical|High\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Failed manifest checks, such as containers running as root or without limits."
    },
    {
      "id": 6,
      "title": "Scanner up",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(up{job=\"trivy-operator\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Vulnerabilities over time (per image)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(max by (image_registry, image_repository, image_tag, severity) (trivy_image_vulnerabilities{severity!=\"Unknown\"})) by (severity)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "Critical + high by namespace",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (namespace) (trivy_image_vulnerabilities{severity=~\"Critical|High\"})",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "description": "Counted per workload, so an image used by several workloads counts several times.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "Images by critical and high vulnerabilities",
      "type": "table",
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (image_registry, image_repository, image_tag) (trivy_image_vulnerabilities{severity=\"Critical\"})",
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "expr": "max by (image_registry, image_repository, image_tag) (trivy_image_vulnerabilities{severity=\"High\"})",
          "instant": true,
          "format": "table",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Critical",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "image_registry": "Registry",
              "image_repository": "Image",
              "image_tag": "Tag",
              "Value #A": "Critical",
              "Value #B": "High"
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "Workloads by failed manifest checks",
      "type": "table",
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (namespace, resource_kind, resource_name) (trivy_resource_configaudits{severity=\"High\"}) > 0",
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "expr": "sum by (namespace, resource_kind, resource_name) (trivy_resource_configaudits{severity=\"Medium\"}) > 0",
          "instant": true,
          "format": "table",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "High",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "resource_kind": "Kind",
              "resource_name": "Name",
              "Value #A": "High",
              "Value #B": "Medium"
            }
          }
        }
      ],
      "description": "Details: kubectl -n <namespace> describe configauditreport"
    },
    {
      "id": 11,
      "title": "Benchmark checks",
      "type": "table",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (title) (trivy_cluster_compliance{status=\"Pass\"})",
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "expr": "sum by (title) (trivy_cluster_compliance{status=\"Fail\"})",
          "instant": true,
          "format": "table",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Fail",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "title": "Benchmark",
              "Value #A": "Pass",
              "Value #B": "Fail"
            }
          }
        }
      ],
      "description": "Details: kubectl get clustercompliancereports"
    },
    {
      "id": 12,
      "title": "RBAC: roles with critical or high findings",
      "type": "table",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (namespace, name) (trivy_role_rbacassessments{severity=~\"Critical|High\"}) > 0",
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "expr": "sum by (name) (trivy_clusterrole_clusterrbacassessments{severity=~\"Critical|High\"}) > 0",
          "instant": true,
          "format": "table",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "ClusterRole findings",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "name": "Report",
              "Value #A": "Role findings",
              "Value #B": "ClusterRole findings"
            }
          }
        }
      ]
    }
  ]
}

    {
      "id": 2,
      "title": "Page views",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "cloudflare"
      },
      "targets": [
        {
          "type": "graphql",
          "source": "url",
          "parser": "jq-backend",
          "format": "table",
          "url": "https://api.cloudflare.com/client/v4/graphql",
          "url_options": {
            "method": "POST",
            "body_type": "graphql",
            "body_content_type": "application/json",
            "body_graphql_query": "query($acc: string!, $from: Time!, $to: Time!) { viewer { accounts(filter: {accountTag: $acc}) { rumPageloadEventsAdaptiveGroups(limit: 1, filter: {AND: [{datetime_geq: $from}, {datetime_leq: $to}, {requestHost: \"jeffriffle.com\"}, {requestPath_notlike: \"/admin%\"}]}) { count } } } }",
            "body_graphql_variables": "{\"acc\": \"${CLOUDFLARE_ACCOUNT_ID}\", \"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\"}"
          },
          "root_selector": "[.data.viewer.accounts[0].rumPageloadEventsAdaptiveGroups[] | {views: .count}]",
          "columns": [
            {
              "selector": "views",
              "text": "Page views",
              "type": "number"
            }
          ],
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "cloudflare"
          }
        }
      ],
      "description": "Page loads measured in visitors' browsers by Cloudflare, jeffriffle.com only (not /admin).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },

            "body_graphql_query": "query($acc: string!, $from: Time!, $to: Time!) { viewer { accounts(filter: {accountTag: $acc}) { rumPageloadEventsAdaptiveGroups(limit: 15, filter: {AND: [{datetime_geq: $from}, {datetime_leq: $to}, {requestHost: \"jeffriffle.com\"}, {requestPath_notlike: \"/admin%\"}]}, orderBy: [count_DESC]) { count dimensions { deviceType } } } } }",
            "body_graphql_variables": "{\"acc\": \"${CLOUDFLARE_ACCOUNT_ID}\", \"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\"}"
          },
          "root_selector": "[.data.viewer.accounts[0].rumPageloadEventsAdaptiveGroups[] | {name: .dimensions.deviceType, views: .count}]",
          "columns": [
            {
              "selector": "name",
              "text": "Device",
              "type": "string"
            },
            {
              "selector": "views",
              "text": "Page views",
              "type": "number"
            }
          ],
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "cloudflare"
          }
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"

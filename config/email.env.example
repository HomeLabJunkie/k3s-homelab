# Optional SMTP override. By default the DR notifier reuses ADMIN_EMAIL from
# config/cluster.env and VAULTWARDEN_SMTP_* credentials from .secrets.enc.
# Copy this file to config/email.env only when a different SMTP account is
# required. Never commit config/email.env.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=on
SMTP_USER=dr-alerts@example.com
SMTP_PASSWORD=replace-with-app-password-or-smtp-password
MAIL_FROM=dr-alerts@example.com
MAIL_TO=you@example.com

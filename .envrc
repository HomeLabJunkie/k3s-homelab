# shellcheck shell=bash
if [[ -f .venv/bin/activate ]]; then
  # shellcheck disable=SC1091
  source .venv/bin/activate
  export PATH="$PWD/.venv/bin:$PATH"
else
  echo "direnv: .venv is missing; create the project virtual environment first" >&2
fi

# Two-laptop sync reminder from the private companion repo; silent when there
# is nothing to do or the companion repo is not checked out.
if [[ -x ../k3s-homelab-private/k3s-sync ]]; then
  ../k3s-homelab-private/k3s-sync status --brief >&2 || true
fi
